# ------------------------------------------------------------------
# Database (Neon / any Postgres). Use the pooled connection string.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------
# Better Auth
# ------------------------------------------------------------------
# Generate one with:  openssl rand -base64 32  (REQUIRED).
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Creem
# ------------------------------------------------------------------
# Test keys are prefixed `creem_test_`, production keys `creem_`.
# The app auto-detects test vs. production mode from this prefix. REQUIRED.
CREEM_API_KEY="creem_test_xxxxxxxxxxxxxxxxx"
# Webhook signing secret from the Creem dashboard (Developers -> Webhooks). REQUIRED.
# Point the webhook at: {NEXT_PUBLIC_APP_URL}/api/auth/creem/webhook
CREEM_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------
# Credit pack -> Creem product mapping. REQUIRED (one product per pack).
# Each pack's "Buy" button opens a real Creem checkout for that product;
# the wallet is credited from the checkout.completed webhook.
# ------------------------------------------------------------------
CREEM_PRODUCT_STARTER="prod_xxxxxxxxxxxxxxxxx"
CREEM_PRODUCT_PRO="prod_xxxxxxxxxxxxxxxxx"
CREEM_PRODUCT_STUDIO="prod_xxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------
# Generation backend (swappable). "stub" ships by default.
# ------------------------------------------------------------------
GENERATOR="stub"
