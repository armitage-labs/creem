{
  "name": "aperture",
  "description": "A safe, metered AI image & video generator built on Creem (credits + moderation).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "auth:generate": "better-auth generate",
    "test": "node --import tsx --env-file=.env.local --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@creem_io/better-auth": "^1.1.0",
    "@neondatabase/serverless": "^0.10.4",
    "better-auth": "^1.3.34",
    "creem": "^1.6.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.x"
  }
}
