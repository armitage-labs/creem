{
  "name": "@creem_io/nextjs",
  "version": "0.5.5",
  "description": "Creem payment integration for Next.js applications",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict --pack pnpm && attw --pack ."
  },
  "keywords": [
    "creem",
    "nextjs",
    "adaptor",
    "payments",
    "subscriptions"
  ],
  "author": "Creem",
  "license": "MIT",
  "peerDependencies": {
    "next": ">=13.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@creem_io/webhook-types": "workspace:^",
    "creem": "workspace:^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "next": "^14.0.0",
    "react": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/armitage-labs/creem.git",
    "directory": "packages/integrations/nextjs"
  },
  "homepage": "https://github.com/armitage-labs/creem/tree/main/packages/integrations/nextjs",
  "bugs": {
    "url": "https://github.com/armitage-labs/creem/issues"
  }
}
