{
  "name": "creem",
  "version": "1.13.0",
  "author": "Speakeasy",
  "bugs": {
    "url": "https://github.com/armitage-labs/creem/issues"
  },
  "description": "Official TypeScript SDK and MCP server for the Creem API",
  "files": [
    "bin",
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "RELEASES.md"
  ],
  "homepage": "https://github.com/armitage-labs/creem/tree/main/packages/sdk",
  "license": "MIT",
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "repository": {
    "directory": "packages/sdk",
    "type": "git",
    "url": "https://github.com/armitage-labs/creem.git"
  },
  "type": "module",
  "bin": {
    "mcp": "bin/mcp-server.js"
  },
  "tshy": {
    "sourceDialects": [
      "creem/source"
    ],
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./types": "./src/types/index.ts",
      "./models/errors": "./src/models/errors/index.ts",
      "./models/components": "./src/models/components/index.ts",
      "./models/operations": "./src/models/operations/index.ts",
      "./*.js": "./src/*.ts",
      "./*": "./src/*.ts"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/armitage-labs/creem.git",
    "directory": "packages/sdk"
  },
  "scripts": {
    "lint": "eslint --cache --max-warnings=0 src",
    "build:mcp": "bun src/mcp-server/build.mts",
    "build": "npm run build:mcp && tshy",
    "prepublishOnly": "npm run build",
    "check:package": "publint --strict --pack pnpm && attw --pack .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@stricli/core": "^1.1.1",
    "@types/express": "^4.17.21",
    "bun": "1.2.17",
    "bun-types": "1.2.17",
    "dotenv": "^16.5.0",
    "eslint": "^9.26.0",
    "express": "^4.21.2",
    "globals": "^15.14.0",
    "tshy": "^3.3.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "jsonpath-rfc9535": "1.1.0",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
