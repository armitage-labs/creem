{
  "name": "@creem_io/embed",
  "version": "0.3.4",
  "description": "Framework-agnostic core for embedding Creem checkout (modal & inline).",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict --pack pnpm && attw --pack ."
  },
  "keywords": [
    "creem",
    "checkout",
    "embed",
    "payments"
  ],
  "author": "Creem",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/armitage-labs/creem.git",
    "directory": "packages/ui/embed"
  },
  "homepage": "https://github.com/armitage-labs/creem/tree/main/packages/ui/embed",
  "bugs": {
    "url": "https://github.com/armitage-labs/creem/issues"
  }
}
