# ------------------------------------------------------------------
# Database (Neon / any Postgres). Use the pooled connection string.
# ------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------
# Better Auth
# ------------------------------------------------------------------
# Generate one with:  openssl rand -base64 32  (REQUIRED).
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------
# Creem
# ------------------------------------------------------------------
# Test keys are prefixed `creem_test_`, production keys `creem_`.
# The app auto-detects test vs. production mode from this prefix. REQUIRED.
CREEM_API_KEY="creem_test_xxxxxxxxxxxxxxxxx"
# Webhook signing secret from the Creem dashboard (Developers -> Webhooks). OPTIONAL.
# Purchases are credited by Creem itself, so the app works without a webhook.
# Set it only if you add your own handlers (e.g. `credits.granted`), and point
# the webhook at: {NEXT_PUBLIC_APP_URL}/api/auth/creem/webhook
CREEM_WEBHOOK_SECRET=""

# ------------------------------------------------------------------
# Credit pack -> Creem product mapping. REQUIRED (one product per pack).
# Each product needs an "AI generation credits" feature (Products -> Delivery ->
# Add -> New AI generation credits). The pack's "Buy" button opens a Creem
# checkout for that product, and Creem adds the credits to the buyer's wallet.
# Tip: with CREEM_API_KEY set above, run `pnpm products:setup` to create
# all three products with the feature and print the values below.
# ------------------------------------------------------------------
CREEM_PRODUCT_STARTER="prod_xxxxxxxxxxxxxxxxx"
CREEM_PRODUCT_PRO="prod_xxxxxxxxxxxxxxxxx"
CREEM_PRODUCT_STUDIO="prod_xxxxxxxxxxxxxxxxx"

# ------------------------------------------------------------------
# Generation backend (swappable). "stub" ships by default.
# ------------------------------------------------------------------
GENERATOR="stub"
