# Speakeasy-generated SDK — formatting is owned by `speakeasy run`, not prettier.
# Any prettier reformat here is overwritten on the next regen.
# (Use a `**` glob, not `packages/sdk/`, so the openapi.json exception
# below can re-include the spec — gitignore rules can't re-include files inside
# an excluded directory.)
packages/sdk/**
# Exception: the OpenAPI spec is the input to Speakeasy (we own it, not the
# generator), so it should be prettier-formatted for reviewable diffs.
!packages/sdk/openapi.json

# OpenAPI spec — synced from upstream / generated, not hand-edited.
packages/docs/api-reference/openapi.json

# Standalone templates (e.g. aperture) — they live here for a stable clone/deploy
# URL but ship their own tooling (.prettierrc, lockfile). Keep root formatting,
# lint-staged, and CI out of them so the template stays self-contained.
packages/examples/
